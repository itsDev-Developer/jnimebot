# AnimeDekho Telegram Bot Environment Variables
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
OWNER_ID=123456789

# 400 MB RAM: use MongoDB Atlas (free M0) instead of a local MongoDB container
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/animedekho

# Channels (bot must be admin in both — all values can also be changed later
# from inside the bot with /settings, with no restart needed)
# MAIN_CHANNEL: short "episode added" notices with a Download Now button.
MAIN_CHANNEL=
# STORAGE_CHANNEL: the SECOND channel — this is where the actual video files
# live, each post with quality buttons. Must be different from MAIN_CHANNEL,
# or everything posts into one channel. Leaving this empty is the #1 cause of
# "the download channel never gets anything" — it silently falls back to
# MAIN_CHANNEL. The bot warns about this in its logs at startup.
STORAGE_CHANNEL=
LOG_CHANNEL=
LOG_LEVEL=INFO

# Shown on every "episode added" notice, e.g. "Download In Hindi". Change
# anytime with /settings (no restart needed).
AUDIO_LABEL=Hindi
# Which of the 7 notice designs to use by default (boxed, minimal, cinematic,
# bold_box, hashtag, neon, editorial, or "random"). Pick visually with /settemplate.
NOTIFY_TEMPLATE=boxed

# ---- Low-RAM / speed tuning (fixed at startup — restart after changing) ----
MAX_DOWNLOADS=1       # parallel downloads (keep 1 on 400 MB)
MAX_UPLOADS=2         # parallel uploads
M3U8_THREADS=6        # segment threads for N_m3u8DL-RE (16 was too heavy)
# DOWNLOAD_DIR=/app/data/dl   # must be a real disk, not RAM-backed /tmp

# ---- Scaling & scheduling ----
MAX_CONCURRENT_TASKS=1   # how many series to work on at once (raise once you have more RAM/bandwidth)
TRACK_POLL_SECONDS=1800  # how often /track'ed series are checked for new episodes (30 min)
TIMEZONE=UTC             # used to interpret /addtask ... at=20:30 and /reschedule
PORT=8080                # health check endpoint: GET /health (used by Docker/Railway/Render)
